---
// Hreflang tags for the only page with actual translations: the homepage.
// Supported locales: English (en), Portuguese Brazil (pt-BR).

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const getPathWithoutLocale = (path: string): string => {
  let cleanPath = path.replace(/\/$/, '') || '/';
  if (cleanPath.startsWith('/pt')) {
    cleanPath = cleanPath.replace(/^\/pt/, '') || '/';
  }
  return cleanPath;
};

const pathWithoutLocale = getPathWithoutLocale(currentPath);

// Only the homepage has localized variants. On every other page, omit hreflang
// tags so we don't point search engines to non-existent /pt/ or /es/ URLs.
const hasTranslation = pathWithoutLocale === '/';
---

{hasTranslation && (
  <>
    <link rel="alternate" hreflang="en" href="https://huntermussel.com/" />
    <link rel="alternate" hreflang="en-US" href="https://huntermussel.com/" />
    <link rel="alternate" hreflang="pt-BR" href="https://huntermussel.com/pt/" />
    <link rel="alternate" hreflang="x-default" href="https://huntermussel.com/" />
  </>
)}
