# Required for narration (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: background stock videos/images for scenes
PEXELS_API_KEY=

# Optional: used by upload-video-to-r2.mjs and post-to-instagram.mjs
# These can also be set in the root .env file.
# CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_URL=https://assets.huntermussel.com
# PUBLIC_ASSETS_URL=https://assets.huntermussel.com

# Required for Instagram posting
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
