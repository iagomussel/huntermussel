# LLM provider for storyboard generation: gemini | ollama
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=kimi-k2.7:cloud

# Required for narration (ElevenLabs fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# TTS provider: elevenlabs | voicebox | google
TTS_PROVIDER=voicebox

# Voicebox (used when TTS_PROVIDER=voicebox)
VOICEBOX_HOST=http://127.0.0.1:17493
VOICEBOX_PROFILE_ID=TADA 3B Multilingual
VOICEBOX_LANGUAGE=en

# Optional: background stock videos/images for scenes
PEXELS_API_KEY=

# Optional: used by upload-video-to-r2.mjs and post-to-instagram.mjs
# These can also be set in the root .env file.
# CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_PUBLIC_URL=https://assets.huntermussel.com
# PUBLIC_ASSETS_URL=https://assets.huntermussel.com

# Required for Instagram posting
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
